# ---- Anthropic ------------------------------------------------------------
# Server-side only. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Supabase -------------------------------------------------------------
# Project Settings -> API. The secret key is server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Cron -----------------------------------------------------------------
# Authenticates /api/nudges/run, which is public because Vercel Cron sends no
# cookies. The route returns 401 to everyone while this is unset.
CRON_SECRET=

# ---- Web Push -------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: URL identifying the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Google Health (optional) ---------------------------------------------
# Wearable sync. Scopes are Restricted: connecting accounts must be registered
# test users until the OAuth consent screen passes Google's review.
# GOOGLE_HEALTH_SCOPES overrides the built-in defaults if the pre-GA API shifts.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=
GOOGLE_HEALTH_SCOPES=
